{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Solution",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"./SlideDevPresenter.sln"
			],
			"options": {
				"env": {
					"DOTNET_ROLL_FORWARD": "Major"
				}
			},
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Test Solution",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"./SlideDevPresenter.sln"
			],
			"options": {
				"env": {
					"DOTNET_ROLL_FORWARD": "Major"
				}
			},
			"group": "test",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build App (Debug)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"./src/SlideDevPresenter.App/SlideDevPresenter.App.csproj",
				"-c",
				"Debug"
			],
			"options": {
				"env": {
					"DOTNET_ROLL_FORWARD": "Major"
				}
			},
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Run App",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"./src/SlideDevPresenter.App/SlideDevPresenter.App.csproj",
				"-c",
				"Debug"
			],
			"options": {
				"env": {
					"DOTNET_ROLL_FORWARD": "Major"
				}
			},
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"label": "Build + Run App",
			"dependsOn": [
				"Build App (Debug)",
				"Run App (No Build)"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"label": "Run App (No Build)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"./src/SlideDevPresenter.App/SlideDevPresenter.App.csproj",
				"-c",
				"Debug",
				"--no-build"
			],
			"options": {
				"env": {
					"DOTNET_ROLL_FORWARD": "Major"
				}
			},
			"group": {
				"kind": "none",
				"isDefault": false
			}
		}
	]
}