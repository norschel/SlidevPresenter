<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SlideDevPresenter.App.ViewModels"
        x:Class="SlideDevPresenter.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        mc:Ignorable="d"
        Width="760"
        Height="540"
        MinWidth="600"
        MinHeight="420"
        Icon="/Assets/appicon.ico"
        Title="Settings — Slidev presenter"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <TabControl Grid.Row="0">
            <TabItem Header="Sources">
                <Grid ColumnDefinitions="260,*" Margin="8">
                    <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto,Auto">
                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceViewModel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Git unavailable" FontSize="11" IsVisible="{Binding !CanEnable}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Content="+ Local" Click="AddLocalSource_Click" ToolTip.Tip="Add a local folder"/>
                            <Button Content="+ URL" Command="{Binding AddHostedUrlSourceCommand}" ToolTip.Tip="Add hosted URL"/>
                            <Button Content="+ Git" Command="{Binding AddGitSourceCommand}" ToolTip.Tip="Add a Git repository"/>
                            <Button Content="+ GitHub" Command="{Binding AddGitHubSourceCommand}" ToolTip.Tip="Add a GitHub repository"/>
                            <Button Content="Remove" Command="{Binding RemoveSelectedSourceCommand}" ToolTip.Tip="Remove selected source"/>
                        </WrapPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                            <Button Content="Import list..." Click="ImportSourceList_Click"/>
                            <Button Content="Export list..." Click="ExportSourceList_Click"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="3" MaxHeight="140" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SourceMessage}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1" Margin="12,0,0,0"
                          IsVisible="{Binding SelectedSource, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Name"/>
                            <TextBox Text="{Binding SelectedSource.Name}"/>
                            <TextBlock Text="Type"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceTypes}" SelectedItem="{Binding SelectedSource.TypeName}"/>
                            <TextBlock Text="Location"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox Text="{Binding SelectedSource.Location}" IsReadOnly="{Binding SelectedSource.IsLocal}"/>
                                <Button Grid.Column="1" Click="BrowseLocalFolder_Click" IsVisible="{Binding SelectedSource.IsLocal}" ToolTip.Tip="Browse for a local folder" AutomationProperties.Name="Browse for a local folder">
                                    <PathIcon Width="16" Height="16" Data="M 1,3 L 7,3 L 9,5 L 19,5 L 19,17 L 1,17 Z"/>
                                </Button>
                            </Grid>
                            <CheckBox Content="Enabled" IsChecked="{Binding SelectedSource.IsEnabled}" IsEnabled="{Binding SelectedSource.CanEnable}"/>
                            <TextBlock Text="Checkout folder (optional)" IsVisible="{Binding SelectedSource.IsRepository}"/>
                            <TextBox Text="{Binding SelectedSource.CheckoutPath}" IsVisible="{Binding SelectedSource.IsRepository}"/>
                            <TextBlock Text="Branch (optional)" IsVisible="{Binding SelectedSource.ShowBranch}"/>
                            <AutoCompleteBox Text="{Binding SelectedSource.Branch, Mode=TwoWay}" ItemsSource="{Binding Branches}" IsVisible="{Binding SelectedSource.ShowBranch}" IsEnabled="{Binding SelectedSource.CanEnable}"/>
                            <Button Content="Load branches" Command="{Binding LoadBranchesCommand}" IsVisible="{Binding SelectedSource.ShowBranch}"/>
                            <TextBlock Text="Comment"/>
                            <TextBox Text="{Binding SelectedSource.Comment}"/>
                            <CheckBox Content="Public" IsChecked="{Binding SelectedSource.IsPublic}" IsVisible="{Binding !SelectedSource.IsLocal}"/>
                            <CheckBox Content="Authentication required" IsChecked="{Binding SelectedSource.RequiresAuthentication}" IsVisible="{Binding !SelectedSource.IsLocal}"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Defaults">
                <StackPanel Spacing="10" Margin="12">
                    <TextBlock Text="Default Port"/>
                    <NumericUpDown Value="{Binding DefaultPort}" Minimum="1024" Maximum="65535" Increment="1"/>
                    <TextBlock Text="Default surface mode"/>
                    <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding DefaultMode}" Width="180"/>
                    <CheckBox Content="Auto-increment port if occupied" IsChecked="{Binding AutoIncrementPorts}"/>
                    <CheckBox Content="Open participant on second monitor" IsChecked="{Binding OpenParticipantOnSecondMonitor}"/>
                    <CheckBox Content="Fullscreen participant window" IsChecked="{Binding FullscreenParticipant}"/>
                    <CheckBox Content="Open presenter view on start" IsChecked="{Binding OpenPresenterOnStart}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Appearance">
                <StackPanel Spacing="10" Margin="12">
                    <TextBlock Text="Theme"/>
                    <ComboBox Width="180" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding Theme}"/>
                    <CheckBox Content="Show status bar" IsChecked="{Binding ShowStatusBar}"/>
                    <CheckBox Content="Show ribbon" IsChecked="{Binding ShowRibbon}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Edit">
                <StackPanel Spacing="10" Margin="12">
                    <CheckBox Content="Enable editing in VS Code" IsChecked="{Binding EditingEnabled}" IsEnabled="{Binding HasCodeEditor}"/>
                    <TextBlock Text="VS Code release" IsVisible="{Binding HasCodeEditor}"/>
                    <ComboBox ItemsSource="{Binding AvailableCodeEditors}" SelectedItem="{Binding SelectedCodeEditor}" IsVisible="{Binding HasCodeEditor}" Width="180"/>
                    <TextBlock Text="Stable is the regular VS Code release; Insiders is the preview release." IsVisible="{Binding HasCodeEditor}" TextWrapping="Wrap"/>
                    <TextBlock Text="VS Code was not found. Install VS Code or VS Code Insiders, then reopen Settings." IsVisible="{Binding !HasCodeEditor}" TextWrapping="Wrap"/>
                    <TextBlock Text="Opens the selected local or checked-out repository presentation folder. Remote URLs cannot be edited." TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="WebView">
                <StackPanel Spacing="10" Margin="12">
                    <CheckBox Content="Prefer embedded WebView" IsChecked="{Binding PreferEmbeddedWebView}"/>
                    <CheckBox Content="Allow external browser fallback" IsChecked="{Binding AllowExternalBrowserFallback}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Display">
                <StackPanel Spacing="10" Margin="12">
                    <TextBlock Text="Display Management" FontWeight="SemiBold"/>
                    <CheckBox Content="Auto-detect displays on presentation start" IsChecked="{Binding AutoDetectDisplays}"/>
                    <CheckBox Content="Open participant view fullscreen" IsChecked="{Binding FullscreenParticipantView}"/>
                    <CheckBox Content="Restore display topology on exit" IsChecked="{Binding RestoreDisplayTopologyOnExit}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Keyboard Shortcuts">
                <StackPanel Spacing="10" Margin="12">
                    <TextBlock Text="Presentation Shortcuts" FontWeight="SemiBold"/>
                    <TextBlock Text="Enter an Avalonia KeyGesture string (e.g. F5, Shift+F5, Ctrl+F5). Leave blank to use the OS default." Opacity="0.7" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Start From Beginning" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StartFromBeginningShortcut}" PlaceholderText="OS default (e.g. F5)"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Start From Current Slide" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartFromCurrentSlideShortcut}" PlaceholderText="OS default (e.g. Shift+F5)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Presenter View" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StartPresenterViewShortcut}" PlaceholderText="OS default (e.g. Alt+F5)"/>
                    </Grid>

                    <TextBlock Text="{Binding ShortcutConflictError}"
                               Foreground="OrangeRed"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShortcutConflictError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <Button Content="Restore Defaults" Command="{Binding RestoreDefaultShortcutsCommand}"
                            ToolTip.Tip="Reset all shortcuts to the OS-specific defaults"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Navigation">
                <StackPanel Spacing="10" Margin="12">
                    <TextBlock Text="External Link Behavior" FontWeight="SemiBold"/>
                    <CheckBox Content="Open external links in system browser" IsChecked="{Binding OpenExternalLinksInSystemBrowser}"/>
                    <CheckBox Content="Open external links in embedded browser workspace" IsChecked="{Binding OpenExternalLinksInEmbeddedBrowser}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Text="{Binding ConfigurationMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Export..." Click="Export_Click"/>
                <Button Content="Import..." Click="Import_Click"/>
                <Button Content="Save" Command="{Binding SaveCommand}"/>
                <Button Content="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
