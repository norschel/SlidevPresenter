<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SlideDevPresenter.App.ViewModels"
        x:Class="SlideDevPresenter.App.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        Title="SlideDevPresenter">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="280,*">

        <!-- Ribbon header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#202020" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleButton Content="Home" IsChecked="True"/>
                <ToggleButton Content="Library"/>
                <ToggleButton Content="View"/>
                <Button Content="Settings" Click="Settings_Click" ToolTip.Tip="Open application settings"/>
            </StackPanel>
        </Border>

        <!-- Left: Library panel -->
        <Border Grid.Row="1" Grid.Column="0" Background="#2A2A2A" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Library"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresentationProjectViewModel">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Location}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2"
                        Content="↻ Refresh Library"
                        Command="{Binding RefreshLibraryCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Right: State-based presenter area -->
        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A1A" Padding="24">
            <Panel>

                <!-- Idle: no project selected or ready to launch -->
                <StackPanel IsVisible="{Binding IsIdle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <TextBlock Text="Slidev Presenter"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a presentation from the library, then click Launch."
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="▶  Launch"
                            Command="{Binding LaunchCommand}"
                            HorizontalAlignment="Center"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Starting: Slidev process is spinning up -->
                <StackPanel IsVisible="{Binding IsStarting}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <TextBlock Text="Starting Slidev…"
                               FontSize="18"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Waiting for the dev server to become ready."
                               Opacity="0.6"
                               HorizontalAlignment="Center"/>
                    <Button Content="■  Stop"
                            Command="{Binding StopCommand}"
                            HorizontalAlignment="Center"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Running: server is ready -->
                <StackPanel IsVisible="{Binding IsRunning}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <TextBlock Text="Slidev is running"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Participant URL:" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding ParticipantUrl}" FontFamily="Monospace"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Presenter URL:" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding PresenterUrl}" FontFamily="Monospace"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="Open in Browser"
                                Command="{Binding OpenExternalBrowserCommand}"
                                Padding="12,6"/>
                        <Button Content="■  Stop"
                                Command="{Binding StopCommand}"
                                Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Error: process failed or exited unexpectedly -->
                <StackPanel IsVisible="{Binding IsError}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <TextBlock Text="Error"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="OrangeRed"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               HorizontalAlignment="Center"
                               Opacity="0.8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="↻  Retry"
                                Command="{Binding RetryCommand}"
                                Padding="12,6"/>
                        <Button Content="Open in Browser"
                                Command="{Binding OpenExternalBrowserCommand}"
                                Padding="12,6"/>
                    </StackPanel>
                </StackPanel>

            </Panel>
        </Border>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#202020" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding HostState}" FontSize="12"/>
                <TextBlock Text="|" Opacity="0.4" FontSize="12"/>
                <TextBlock Text="{Binding Port, StringFormat='Port: {0}'}" FontSize="12"/>
                <TextBlock Text="|" Opacity="0.4" FontSize="12"/>
                <TextBlock Text="{Binding ParticipantUrl, StringFormat='Participant: {0}'}" FontSize="12"/>
                <TextBlock Text="|" Opacity="0.4" FontSize="12"/>
                <TextBlock Text="{Binding PresenterUrl, StringFormat='Presenter: {0}'}" FontSize="12"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>

