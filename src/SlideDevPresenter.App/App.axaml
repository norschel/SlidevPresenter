<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:SlideDevPresenter.App.Services"
             x:Class="SlideDevPresenter.App.App"
             Name="Slidev presenter"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="AppChromePanelBrush" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#262626"/>
                    <SolidColorBrush x:Key="AppElevatedBrush" Color="#303030"/>
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#171717"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="#222222"/>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#101010"/>
                    <SolidColorBrush x:Key="AppTabBarBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="AppWindowBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="AppListBrush" Color="#2B2B2B"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="AppChromePanelBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#EDEDED"/>
                    <SolidColorBrush x:Key="AppElevatedBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="AppTabBarBrush" Color="#EBEBEB"/>
                    <SolidColorBrush x:Key="AppWindowBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppListBrush" Color="#F2F2F2"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static services:ThemeService.Blue}">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#0F2A4A"/>
                    <SolidColorBrush x:Key="AppChromePanelBrush" Color="#173A63"/>
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#12304F"/>
                    <SolidColorBrush x:Key="AppElevatedBrush" Color="#1D4573"/>
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#0A1F38"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="#143657"/>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#071629"/>
                    <SolidColorBrush x:Key="AppTabBarBrush" Color="#0D2541"/>
                    <SolidColorBrush x:Key="AppWindowBrush" Color="#0A1F38"/>
                    <SolidColorBrush x:Key="AppListBrush" Color="#102C4C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource AppWindowBrush}"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppListBrush}"/>
        </Style>
    </Application.Styles>
</Application>