<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SlideDevPresenter.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="AppChromePanelBrush" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#262626"/>
                    <SolidColorBrush x:Key="AppElevatedBrush" Color="#303030"/>
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#171717"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="#222222"/>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#101010"/>
                    <SolidColorBrush x:Key="AppTabBarBrush" Color="#1A1A1A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="AppChromePanelBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#EDEDED"/>
                    <SolidColorBrush x:Key="AppElevatedBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="AppTabBarBrush" Color="#EBEBEB"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>